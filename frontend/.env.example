# API Base URL:
# - For local development proxy: /api
# - For cross-origin production (e.g. Vercel frontend calling Render backend): https://your-backend.onrender.com/api
VITE_API_URL=/api

# Razorpay Key ID (Public merchant key for checkout modal — safe for client bundle)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Canonical Site URL (Used for OpenGraph, Twitter cards, and canonical link tags)
VITE_SITE_URL=https://trendvolt.com
