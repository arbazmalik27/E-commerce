PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/trendvolt
# In production, use a strong 256-bit secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
# Comma-separated allowed frontend origins for CORS (e.g. https://trendvolt.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Cookie Configuration (Optional)
# In production with cross-origin hosting (e.g. Vercel + Render), defaults to 'none' with secure: true.
# Set to 'lax' if frontend and backend share the same root domain.
# COOKIE_SAME_SITE=none

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email Service (Resend)
EMAIL_SERVICE_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Automation & Webhooks (On Hold)
N8N_WEBHOOK_URL=
